<script>
function calcularLikert(){

let total=0;
let respondidas=0;

for(let i=1;i<=20;i++){
let seleccion=document.querySelector('input[name="p'+i+'"]:checked');

if(seleccion){
total += parseInt(seleccion.value);
respondidas++;
}
}

if(respondidas<20){
document.getElementById("resultado").innerHTML =
"<strong>Debe responder todos los indicadores.</strong>";
return;
}

let promedio = total/20;
let interpretacion="";

if(promedio>=4.21){
interpretacion="MUY ALTA SATISFACCIÓN";
}else if(promedio>=3.41){
interpretacion="ALTA SATISFACCIÓN";
}else if(promedio>=2.61){
interpretacion="SATISFACCIÓN MODERADA";
}else if(promedio>=1.81){
interpretacion="BAJA SATISFACCIÓN";
}else{
interpretacion="MUY BAJA SATISFACCIÓN";
}

document.getElementById("resultado").innerHTML=
"<h3>Resultados</h3>"+
"<p><strong>Puntaje Total:</strong> "+total+" de 100</p>"+
"<p><strong>Promedio:</strong> "+promedio.toFixed(2)+" / 5</p>"+
"<p><strong>Interpretación:</strong> "+interpretacion+"</p>";
}
</script>
